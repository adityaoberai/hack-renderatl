# ---------------------------------------------------------------------------
# Relief ATL environment
# ---------------------------------------------------------------------------

# Tiger Data (PostgreSQL + TimescaleDB) connection string.
#
# Create a service at https://www.tigerdata.com / Timescale Cloud and paste its
# connection string here, then run:
#
#   npm run db:setup     # tables, reports hypertable, continuous aggregate
#   npm run db:import    # load the imported public datasets
#
# If this is unset the app still runs: it serves the same imported public
# datasets from an in-memory store so a demo never depends on the network.
# Tiger Data is the system of record whenever it is reachable.
DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:39999/tsdb?sslmode=require

# Port for the adapter-node server in production (DigitalOcean sets this itself).
# PORT=3000
